---
// OBS browser source. One participant, full-bleed, nothing else.
//
// Anything visible on this page goes on air, so there is deliberately no UI: no
// labels, no borders, no spinners, no error text. When something goes wrong the page
// stays black and the captain sees a black source, which is the correct failure mode
// during a live recording. Append &debug=1 to surface a diagnostic overlay while
// setting things up; it is never shown otherwise.
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Ngobrolin - OBS source</title>
    <style>
      html,
      body {
        margin: 0;
        padding: 0;
        width: 100%;
        height: 100%;
        overflow: hidden;
        /* Transparent so an OBS scene can composite this over a background. OBS
           browser sources honour page transparency; a plain browser tab will show
           the page as black instead, which is the same thing on air. */
        background: transparent;
      }

      #stage {
        position: fixed;
        inset: 0;
        background: #000;
      }

      #stage video {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
        /* Never mirrored: the preview flip is a self-view affordance and must not
           reach the broadcast. */
      }

      /* Only ever visible with &debug=1. */
      #debug {
        position: fixed;
        left: 0;
        top: 0;
        margin: 0;
        padding: 6px 10px;
        font: 12px/1.4 ui-monospace, SFMono-Regular, Menlo, monospace;
        color: #0f0;
        background: rgba(0, 0, 0, 0.75);
        white-space: pre;
      }
    </style>
  </head>
  <body>
    <div id="stage">
      <video id="feed" autoplay playsinline></video>
    </div>
    <pre id="debug" hidden></pre>

    <script>
      import { startViewPage } from '../scripts/view.ts';
      startViewPage();
    </script>
  </body>
</html>
