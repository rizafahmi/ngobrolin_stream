---
// Join page. Everything below the join button is client-side; the server ships plain
// HTML. Guest-facing copy is Indonesian by design.
import '../styles/join.css';
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Ngobrolin - Masuk Studio</title>
  </head>
  <body>
    <!-- ================= Stage 1: join ================= -->
    <section id="stage-join">
      <div class="card">
        <div class="card-head">
          <h1 class="wordmark">Ngobrol<span>in</span></h1>
          <p>Studio rekaman</p>
        </div>

        <div class="preview">
          <video id="preview-video" autoplay playsinline muted hidden></video>
          <div class="preview-placeholder" id="preview-placeholder">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <rect x="2" y="6" width="13" height="12" rx="2" />
              <path d="M15 10.5 22 7v10l-7-3.5z" />
            </svg>
            <span id="preview-caption">Kamera belum aktif</span>
          </div>
        </div>

        <div class="panel">
          <!-- State: waiting for the guest to trigger the permission prompt. -->
          <div id="panel-permission">
            <h2>Izinkan kamera dan mikrofon</h2>
            <p>
              Setelah kamu menekan tombol di bawah, Chrome akan menampilkan kotak kecil di pojok
              kiri atas layar. Pilih <strong>Izinkan</strong> supaya wajah dan suara kamu bisa
              dikirim ke studio.
            </p>
            <div class="spacer"></div>
            <button class="btn" id="btn-permission" type="button">Izinkan Kamera &amp; Mikrofon</button>
          </div>

          <!-- State: permission was denied, this time or on a previous visit. -->
          <div id="panel-denied" hidden>
            <h2>Kamera dan mikrofon diblokir</h2>
            <p>Chrome masih menolak akses. Buka lagi izinnya seperti ini:</p>
            <ol>
              <li>Klik ikon <strong>kamera dicoret</strong> di ujung kanan kolom alamat Chrome.</li>
              <li>Pilih <strong>Selalu izinkan</strong> untuk kamera dan mikrofon.</li>
              <li>Klik <strong>Selesai</strong>, lalu tekan tombol di bawah.</li>
            </ol>
            <div class="spacer"></div>
            <button class="btn" id="btn-retry" type="button">Coba Lagi</button>
          </div>

          <!-- State: no camera or microphone exists on the machine. -->
          <div id="panel-nodevice" hidden>
            <h2>Kamera atau mikrofon tidak terdeteksi</h2>
            <p>
              Pastikan webcam dan headset sudah tercolok, lalu tutup aplikasi lain yang mungkin
              sedang memakainya (Zoom, Meet, Photo Booth).
            </p>
            <div class="spacer"></div>
            <button class="btn" id="btn-retry-device" type="button">Coba Lagi</button>
          </div>

          <!-- State: ready to join. -->
          <div id="panel-ready" hidden>
            <div class="field">
              <label for="input-name">Nama kamu</label>
              <input id="input-name" type="text" autocomplete="off" maxlength="40" placeholder="Nama yang muncul di layar" />
            </div>
            <div class="field-row">
              <div class="field">
                <label for="select-camera">Kamera</label>
                <select id="select-camera"></select>
              </div>
              <div class="field">
                <label for="select-mic">Mikrofon</label>
                <select id="select-mic"></select>
              </div>
              <!-- Hidden until the browser proves it can actually switch outputs. -->
              <div class="field field-wide" id="field-speaker" hidden>
                <label for="select-speaker">Speaker</label>
                <select id="select-speaker"></select>
              </div>
            </div>
            <div class="meter"><div class="meter-fill" id="meter-fill"></div></div>
            <p class="hint">Coba bicara sebentar. Batang hijau di atas harus bergerak.</p>
            <div class="spacer"></div>
            <button class="btn" id="btn-join" type="button">Masuk Studio</button>
          </div>

          <!-- State: the link itself is unusable, so nothing else can help. -->
          <div id="panel-fatal" hidden>
            <h2 id="fatal-title">Link tidak lengkap</h2>
            <p id="fatal-body">
              Link ini tidak berisi kode masuk. Minta link baru ke Riza, lalu buka link itu
              langsung tanpa mengetik ulang alamatnya.
            </p>
          </div>

          <div class="alert" id="join-error" hidden></div>
        </div>
      </div>
    </section>

    <!-- ================= Stage 2: in-room ================= -->
    <section id="stage-room" hidden>
      <header class="room-head">
        <h1 class="wordmark">Ngobrol<span>in</span></h1>
        <span class="status" id="room-status" data-state="connecting">Menyambung...</span>
      </header>

      <div class="grid" id="grid"></div>

      <footer class="room-foot">
        <!-- Device pickers live in a popover so the footer stays a conversation
             surface: one button, three selects only while the guest needs them. -->
        <div class="devices-pop" id="devices-pop" hidden>
          <div class="field">
            <label for="select-camera-room">Kamera</label>
            <select id="select-camera-room"></select>
          </div>
          <div class="field">
            <label for="select-mic-room">Mikrofon</label>
            <select id="select-mic-room"></select>
          </div>
          <div class="field" id="field-speaker-room" hidden>
            <label for="select-speaker-room">Speaker</label>
            <select id="select-speaker-room"></select>
          </div>
          <div class="alert" id="devices-error" hidden></div>
        </div>
        <button class="ctrl" id="btn-mic" type="button" data-off="false">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
            <rect x="9" y="2" width="6" height="11" rx="3" />
            <path d="M5 11a7 7 0 0 0 14 0M12 18v4" />
          </svg>
          <span id="btn-mic-label">Mikrofon aktif</span>
        </button>
        <button class="ctrl" id="btn-cam" type="button" data-off="false">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
            <rect x="2" y="6" width="13" height="12" rx="2" />
            <path d="M15 10.5 22 7v10l-7-3.5z" />
          </svg>
          <span id="btn-cam-label">Kamera aktif</span>
        </button>
        <button class="ctrl" id="btn-devices" type="button" data-active="false">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
            <circle cx="12" cy="12" r="3" />
            <path d="M19.4 15a1.7 1.7 0 0 0 .34 1.87l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.7 1.7 0 0 0-1.87-.34 1.7 1.7 0 0 0-1.03 1.56V21a2 2 0 1 1-4 0v-.09A1.7 1.7 0 0 0 8.98 19.4a1.7 1.7 0 0 0-1.87.34l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.7 1.7 0 0 0 .34-1.87 1.7 1.7 0 0 0-1.56-1.03H3a2 2 0 1 1 0-4h.09A1.7 1.7 0 0 0 4.65 8.98a1.7 1.7 0 0 0-.34-1.87l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.7 1.7 0 0 0 1.87.34h.01A1.7 1.7 0 0 0 10.05 3.1V3a2 2 0 1 1 4 0v.09a1.7 1.7 0 0 0 1.03 1.56 1.7 1.7 0 0 0 1.87-.34l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.7 1.7 0 0 0-.34 1.87v.01a1.7 1.7 0 0 0 1.56 1.03H21a2 2 0 1 1 0 4h-.09a1.7 1.7 0 0 0-1.51 1.05z" />
          </svg>
          <span>Perangkat</span>
        </button>
        <button class="ctrl ctrl-leave" id="btn-leave" type="button">Keluar</button>
      </footer>
    </section>

    <script>
      import { startJoinPage } from '../scripts/join.ts';
      startJoinPage();
    </script>
  </body>
</html>
