# Copy to .env and fill in. .env is gitignored; never commit real credentials.

# LiveKit signalling URL the browser connects to.
# Read at BUILD time, so changing it requires `npm run build` again.
# Local dev (livekit-server --dev): ws://localhost:7880
PUBLIC_LIVEKIT_URL=ws://localhost:7880
# LiveKit Cloud (the deployed setup): the project's own wss:// address.
# PUBLIC_LIVEKIT_URL=wss://your-project-xxxxxxxx.livekit.cloud

# Where the site is served from. Used by scripts/mint.ts to build the links.
PUBLIC_SITE_URL=http://localhost:4321

# LiveKit API credentials. Used ONLY by scripts/mint.ts, never shipped to the browser.
# `livekit-server --dev` hardcodes these two well-known development values.
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
# LiveKit Cloud: the project's own key and secret. Changing these invalidates every
# existing guest link, so re-mint all of them after switching.
# LIVEKIT_API_KEY=APIxxxxxxxxxxxx
# LIVEKIT_API_SECRET=replace-with-the-cloud-project-secret
