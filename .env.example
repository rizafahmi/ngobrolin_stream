# Copy to .env and fill in. .env is gitignored; never commit real credentials.

# LiveKit signalling URL the browser connects to.
# Local dev (livekit-server --dev): ws://localhost:7880
PUBLIC_LIVEKIT_URL=ws://localhost:7880

# Where the site is served from. Used by scripts/mint.ts to build the links.
PUBLIC_SITE_URL=http://localhost:4321

# LiveKit API credentials. Used ONLY by scripts/mint.ts, never shipped to the browser.
# `livekit-server --dev` hardcodes these two well-known development values.
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
